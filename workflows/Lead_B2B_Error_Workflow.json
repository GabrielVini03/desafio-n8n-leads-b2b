    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Normaliza o payload do Error Trigger num registro estruturado de log.\nconst esc = (valor) => String(valor ?? '—')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\nconst registro = {\n  erro_global: true,\n  workflow: $json.workflow?.name ?? null,\n  execucao_id: $json.execution?.id ?? null,\n  execucao_url: $json.execution?.url ?? null,\n  ultimo_no: $json.execution?.lastNodeExecuted ?? null,\n  mensagem: $json.execution?.error?.message ?? 'Erro desconhecido',\n  modo: $json.execution?.mode ?? null,\n  registrado_em: new Date().toISOString()\n};\n\nregistro.texto = [\n  '🚨 <b>Falha não tratada no workflow</b>',\n  '',\n  `⚙️ ${esc(registro.workflow)}`,\n  `🧩 Nó: ${esc(registro.ultimo_no)}`,\n  `❌ ${esc(registro.mensagem)}`,\n  `🆔 Execução ${esc(registro.execucao_id)}`\n].join('\\n');\n\nreturn registro;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "id": "d70c73e6-6c8a-45b3-a39d-f4b6cc72b518",
      "name": "Registrar Erro Global"
    },
    {
      "parameters": {
