# Copie para .env (o scripts/setup.sh faz isso automaticamente na primeira execução).

# --- n8n ---------------------------------------------------------------
# Porta do host onde a UI e o webhook ficam expostos (não usar N8N_PORT: é lida pelo próprio n8n).
HOST_PORT=5678
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo
# O n8n 2.x bloqueia $env em expressões por padrão. Os endpoints e o token do
# Telegram são lidos via $env, então o acesso precisa estar liberado.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# --- Endpoints externos (lidos no workflow via $env) -----------------------
VIACEP_BASE_URL=https://viacep.com.br
BRASILAPI_BASE_URL=https://brasilapi.com.br
TELEGRAM_API_BASE_URL=https://api.telegram.org

# --- Resiliência ----------------------------------------------------------
# Timeout de cada chamada HTTP externa (ms). Sem isso o n8n espera até 5 min.
HTTP_TIMEOUT_MS=5000

# --- Idempotência ---------------------------------------------------------
# Janela em que o mesmo CNPJ é considerado duplicado (segundos).
IDEMPOTENCIA_JANELA_SEGUNDOS=300

# --- Postgres (persistência e idempotência) -------------------------------
POSTGRES_DB=leads
POSTGRES_USER=n8n_leads
POSTGRES_PASSWORD=n8n_leads_local

# --- Telegram (opcional: vazio = notificação desligada, o fluxo segue normal)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
